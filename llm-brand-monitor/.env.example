# ========= 被监测的国产大模型（配哪个就监测哪个，不配自动跳过）=========
# 豆包 / 火山方舟  https://console.volcengine.com/ark
ARK_API_KEY=
# DOUBAO_MODEL=doubao-pro-32k          # 也可填方舟接入点 ID（ep-xxxx）

# 通义千问 / 阿里百炼  https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=
# QWEN_MODEL=qwen-plus

# DeepSeek  https://platform.deepseek.com
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# 智谱 GLM  https://open.bigmodel.cn
ZHIPU_API_KEY=
# GLM_MODEL=glm-4-plus

# Kimi / 月之暗面  https://platform.moonshot.cn
MOONSHOT_API_KEY=
# KIMI_MODEL=moonshot-v1-8k

# 文心一言 / 百度千帆  https://console.bce.baidu.com/qianfan
QIANFAN_API_KEY=
# ERNIE_MODEL=ernie-4.5-turbo-128k

# 腾讯混元  https://console.cloud.tencent.com/hunyuan
HUNYUAN_API_KEY=
# HUNYUAN_MODEL=hunyuan-turbos-latest

# 讯飞星火  https://console.xfyun.cn  （APIKey:APISecret 整体填入）
SPARK_API_KEY=
# SPARK_MODEL=4.0Ultra

# MiniMax  https://platform.minimaxi.com
MINIMAX_API_KEY=
# MINIMAX_MODEL=abab6.5s-chat

# 百川  https://platform.baichuan-ai.com
BAICHUAN_API_KEY=
# BAICHUAN_MODEL=Baichuan4-Turbo

# ========= 采集参数 =========
MONITOR_REPEATS=3          # 每题重复采样次数，越大结果越稳
MONITOR_TEMPERATURE=0.7    # 贴近用户真实使用场景，不要设 0
MONITOR_CONCURRENCY=4      # 并发数，注意各家 QPS 限制
MONITOR_MAX_TOKENS=1600
